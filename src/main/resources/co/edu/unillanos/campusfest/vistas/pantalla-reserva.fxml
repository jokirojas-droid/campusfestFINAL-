<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<VBox xmlns:fx="http://javafx.com/fxml" spacing="16" styleClass="pagina" stylesheets="@estilos.css" prefWidth="760" prefHeight="570">
    <children>
        <Label text="CAMPUSFEST  /  CU2" styleClass="sobrelinea" />
        <Label text="Reservar entrada" styleClass="titulo" />
        <Label text="Solicita una reserva y confírmala usando el código generado." styleClass="descripcion" wrapText="true" />
        <VBox spacing="11" styleClass="tarjeta">
            <children>
                <Label text="Identificador del evento" styleClass="rotulo" />
                <TextField fx:id="campoEventoId" promptText="Ejemplo: EVT-001" />
                <Label text="Identificador del estudiante" styleClass="rotulo" />
                <TextField fx:id="campoEstudianteId" promptText="Código del estudiante" />
                <Button text="Solicitar reserva" onAction="#alSolicitarReserva" styleClass="boton-principal" />
                <Label text="Código de reserva / QR" styleClass="rotulo" />
                <TextField fx:id="campoCodigoReserva" promptText="Código recibido al reservar" />
                <Button text="Confirmar reserva" onAction="#alConfirmarReserva" styleClass="boton-secundario" />
                <Label fx:id="etiquetaMensaje" text="La aplicación mostrará aquí el resultado." styleClass="mensaje" wrapText="true" />
            </children>
        </VBox>
    </children>
</VBox>
